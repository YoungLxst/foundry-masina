<div class="masina-jet">
  <div class="form-group">
    <label>Avantage</label>
    <select name="mode">
      <option value="0" {{#if (eq mode 0)}}selected{{/if}}>Normal (1d10)</option>
      <option value="1" {{#if (eq mode 1)}}selected{{/if}}>Avantage (2d10, le meilleur)</option>
      <option value="-1" {{#if (eq mode -1)}}selected{{/if}}>Désavantage (2d10, le pire)</option>
    </select>
  </div>
  <div class="form-group">
    <label>Modificateur</label>
    <input type="number" name="bonus" value="0" step="1">
    <p class="hint">±2 petite aide ou gêne, ±4 grosse aide ou gêne.</p>
  </div>
  {{#if avecSD}}
  <div class="form-group">
    <label>Seuil de difficulté</label>
    <select name="sd">
      <option value="">— sans SD —</option>
      {{#each difficultes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
  </div>
  {{/if}}
  {{{extra}}}
</div>
