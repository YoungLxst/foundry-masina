<section class="tab roulement {{tab.cssClass}}" data-group="primary" data-tab="roulement">
  <div class="barre-actions">
    {{#if estPJ}}<span class="compteur {{#if (gt system.roulement.utilises system.roulement.max)}}mauvais{{/if}}">Emplacements : <b>{{system.roulement.utilises}}</b> / {{system.roulement.max}}</span>{{/if}}
    <button type="button" data-action="finCombat" title="Les compétences 1/combat redeviennent disponibles"><i class="fa-solid fa-flag-checkered"></i> Fin du combat</button>
    <button type="button" data-action="itemCreer" data-type="aptitude"><i class="fa-solid fa-plus"></i> Aptitude</button>
  </div>
  <p class="aide">Au début de son tour : une Posture <b>ou</b> une Technique du Roulement. Les Réflexes équipés restent disponibles. Après une Technique, on est à découvert. Le Roulement se change au repos long. Glissez des aptitudes depuis les compendiums « Aptitudes de classe » et « Aptitudes de peuple » : les aptitudes de peuple de Roulement prennent un emplacement normal.</p>

  <h2>Roulement <small>compétences équipées</small></h2>
  <ul class="aptitudes">
    {{#each roulement}}{{> "systems/masina/templates/actor/partials/aptitude-ligne.hbs"}}{{else}}<li class="vide">Aucune compétence équipée.</li>{{/each}}
  </ul>

  <h2 class="mt">Compétences apprises <small>non équipées</small></h2>
  <ul class="aptitudes">
    {{#each apprises}}{{> "systems/masina/templates/actor/partials/aptitude-ligne.hbs"}}{{else}}<li class="vide">—</li>{{/each}}
  </ul>

  <h2 class="mt">Aptitudes passives</h2>
  <ul class="aptitudes">
    {{#each passifs}}{{> "systems/masina/templates/actor/partials/aptitude-ligne.hbs"}}{{else}}<li class="vide">—</li>{{/each}}
  </ul>
</section>
