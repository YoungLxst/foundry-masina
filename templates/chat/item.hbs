<div class="masina-carte">
  <header class="avec-image">
    <img src="{{item.img}}" alt="">
    <div>
      <h3>{{item.name}}</h3>
      {{#if system.genreLabel}}<div class="sous-titre">{{system.genreLabel}}{{#if system.limiteLabel}} · {{system.limiteLabel}}{{/if}}{{#if system.origineLabel}} · {{system.origineLabel}}{{/if}}</div>{{/if}}
    </div>
  </header>
  {{#if system.citation}}<p class="citation">{{system.citation}}</p>{{/if}}
  <div class="contenu">
    {{#if system.effet}}{{{system.effet}}}{{/if}}
    {{#if system.contrepartie}}<div class="contrepartie">{{{system.contrepartie}}}</div>{{/if}}
    {{#if system.description}}{{{system.description}}}{{/if}}
  </div>
</div>
